# ===== Heartless configuration =====
# Only the Binance keys are required. Everything else has sensible defaults.

# --- Binance USDⓈ-M Futures API (required for live trading; paper mode works with public data only) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Use the Binance Futures testnet (https://testnet.binancefuture.com) instead of production.
BINANCE_TESTNET=false

# --- Telegram (recommended). Create a bot with @BotFather and paste its token. ---
# The first person who sends `/start <pairing code>` becomes the only owner. The code is printed in the logs.
TELEGRAM_BOT_TOKEN=
# Optional: pin the owner up-front (numeric Telegram user id). Leave this line commented out to use the pairing flow.
# (It is an integer field: do NOT ship it as a blank `TELEGRAM_OWNER_ID=`; uncomment and set a real id instead.)
# TELEGRAM_OWNER_ID=123456789

# --- Trading mode: paper (default, no real money) | live ---
# In paper mode, with Binance keys set, the bot sends a "Go live" button on Telegram once the paper champion's own trades
# pass the graduation criteria (challenger trades do not count; nothing switches without the confirmation button).
HEARTLESS_MODE=paper

# --- Optional: infrastructure ---
# Data folder (SQLite stores, logs, secrets.json); docker-compose sets /app/data.
# HEARTLESS_DATA_DIR=data
# LOG_LEVEL=INFO

# --- Optional: bulk history from the public Binance data archive (default on)
# ARCHIVE_BACKFILL=true

# --- Optional: trading universe, chosen by rule and never by name (docs/UNIVERSE.md) ---
# Every USDT perpetual that is trading, listed at least UNIVERSE_MIN_AGE_DAYS, not a stablecoin, with a 24h quote volume
# of at least UNIVERSE_MIN_QUOTE_VOLUME (USDT) and a tick no coarser than UNIVERSE_MAX_TICK_BPS of the price; the most
# liquid UNIVERSE_SIZE trade, re-selected every UNIVERSE_REFRESH_MINUTES (a member stays until its volume falls below 80%
# of the floor). UNIVERSE_MAX_SPREAD_BPS applies only once the selection is given book tickers (not fetched yet).
# UNIVERSE_SIZE=16
# UNIVERSE_MIN_QUOTE_VOLUME=80000000
# UNIVERSE_REFRESH_MINUTES=60
# UNIVERSE_MIN_AGE_DAYS=30
# UNIVERSE_MAX_TICK_BPS=10.0
# UNIVERSE_MAX_SPREAD_BPS=5.0
# Market data always subscribed (BTC is the regime and market-context reference): a data subscription, not a trading
# guarantee. Until the app subscribes these as data only, a listed symbol that fails a rule is still traded (logged).
# ALWAYS_INCLUDE=BTCUSDT
# Days of 1m history the live feature views load at start.
# HISTORY_DAYS=21
# Research dataset: exchange-wide symbol inventory and 1h futures / spot blocks (empty: <data dir>/universe.db).
# UNIVERSE_DB=

# --- Optional: risk limits (deliberately conservative; the optimizer never changes them) ---
# Equity lost at the stop per trade (%) and its cap, position count limits, leverage caps (notional / equity), the margin
# leverage set per symbol, the daily / weekly loss halts (%) and the drawdown pause (%).
# RISK_PER_TRADE_PCT=0.5
# MAX_RISK_PER_TRADE_PCT=1.25
# MAX_POSITIONS=5
# MAX_SAME_DIRECTION=3
# MAX_POSITION_LEVERAGE=5.0
# MAX_GROSS_LEVERAGE=12.0
# EXCHANGE_LEVERAGE=10
# DAILY_LOSS_LIMIT_PCT=3.0
# WEEKLY_LOSS_LIMIT_PCT=7.0
# MAX_DRAWDOWN_HALT_PCT=15.0
# Paper account start balance (USDT), fee rates, and the simulated market-order slippage (bps) of backtests.
# PAPER_INITIAL_BALANCE=10000.0
# TAKER_FEE=0.0005
# MAKER_FEE=0.0002
# BACKTEST_SLIPPAGE_BPS=1.5

# --- Optional: web dashboard (token is auto-generated and sent via /web on Telegram) ---
# Loopback by default: the dashboard carries live-money controls over plain HTTP. Set 0.0.0.0 only behind an HTTPS
# reverse proxy / VPN (docker-compose sets it for the container and maps the port to the host's 127.0.0.1 only).
WEB_HOST=127.0.0.1
WEB_PORT=8080
# WEB_ENABLED=true

# --- Optional: Anthropic key enables the daily AI post-mortem advisor (pip install heartless[advisor]) ---
ANTHROPIC_API_KEY=

# --- Optional: reporting timezone for daily reports ---
TIMEZONE=Asia/Seoul

# --- Optional: self-improvement loop (defaults are fine; docs/SELF_IMPROVEMENT.md) ---
# History kept for research/discovery (live features only need ~3 weeks); bulk-loaded from the public archive. A floor:
# raised to RESEARCH_LOOKBACK_DAYS + the longest research warm-up + 2 days when that is longer (default 214 days).
# DATA_RETENTION_DAYS=180
# Walk-forward optimisation every RESEARCH_INTERVAL_MINUTES (never sooner than twice the last cycle's length) over
# RESEARCH_LOOKBACK_DAYS with RESEARCH_FOLDS confirmation windows. A cycle tunes the champion's enabled alphas, the
# disabled ones not marked failed and RESEARCH_FAILED_PER_CYCLE of the failed ones in rotation.
# RESEARCH_INTERVAL_MINUTES=120
# RESEARCH_FAILED_PER_CYCLE=2
# RESEARCH_LOOKBACK_DAYS=120
# RESEARCH_FOLDS=3
# RESEARCH_CANDIDATES=10
# Automatic alpha discovery (rule mining with multiple-testing control) every DISCOVERY_INTERVAL_HOURS; all
# DISCOVERY_GRIDS are mined in one run, so the multiple-testing bar counts the rules of every grid.
# DISCOVERY_INTERVAL_HOURS=24
# DISCOVERY_MIN_DAYS=45
# DISCOVERY_GRIDS=15m,1h
# Paper challengers: promotion is judged only at the checkpoints 14/30/60/90 days after a challenger starts, on
# Newey-West (HAC) day statistics against calibrated thresholds (code constants); these set the minimum trades / exit
# days of the bar and the number of slots.
# CHALLENGERS=2
# PROMOTION_MIN_TRADES=25
# PROMOTION_MIN_DAYS=14
# A change that was judged and retired is not tried again for this many days.
# CHALLENGER_RETRY_DAYS=90
# Per-alpha kill switch on live (paper or real) results: CUSUM in standard deviations of the alpha's R, or the R sum of
# its last KILL_SWITCH_WINDOW trades below KILL_SWITCH_WINDOW_R.
# KILL_SWITCH=true
# KILL_SWITCH_K=0.25
# KILL_SWITCH_H=8.0
# KILL_SWITCH_WINDOW=30
# KILL_SWITCH_WINDOW_R=-20.0
# Meta-labeling (per-alpha veto / scaling by context; off until validated) and the samples it needs per alpha.
# META_LABEL=false
# META_MIN_SAMPLES=120
# The "Go live" offer: the paper champion's own trades need this many trades, this profit factor and at most this
# drawdown (%).
# GRADUATION_MIN_TRADES=60
# GRADUATION_MIN_PF=1.25
# GRADUATION_MAX_DD_PCT=8.0
# Daily report at this local hour (TIMEZONE).
# DAILY_REPORT_HOUR=9
# Execution-quality monitor: rolling fills per engine, and the taker fills from which the reports suggest raising
# BACKTEST_SLIPPAGE_BPS (never changed automatically).
# EXEC_QUALITY_WINDOW=200
# EXEC_QUALITY_MIN_FILLS=50

# --- Optional: portfolio construction (docs/PORTFOLIO.md; off by default: the P3 acceptance rule needs an enabled alpha) ---
# Batch one bar close's entry candidates, rank them by expected value and admit them within the risk budgets (% of
# equity; the same-direction budget is weighted by each symbol's BTC beta). Off: FIFO under the count limits.
# PORTFOLIO_ALLOCATOR=false
# MAX_TOTAL_RISK_PCT=2.5
# MAX_SAME_DIRECTION_RISK_PCT=1.5
# BETA_LOOKBACK_DAYS=30
# Market entries are sized for a fill this many bps (plus the modelled slippage and a tick) beyond the decision touch.
# MARKET_ENTRY_BUFFER_BPS=1.5

# --- Optional: market context (hourly cross-sectional features, docs/RESEARCH_TOOLS.md) ---
# CONTEXT_UNIVERSE=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,LTCUSDT,BCHUSDT,BNBUSDT,SUIUSDT,DOTUSDT,ATOMUSDT,NEARUSDT,FILUSDT,ETCUSDT,TRXUSDT,UNIUSDT,AAVEUSDT
# Store of the context rows (empty: <data dir>/context.db). The bot appends every hourly snapshot to it and its research
# backtests read it.
# CONTEXT_DB=
# lab / discover build missing context years on demand (off: only stored rows are used).
# CONTEXT_AUTO_BUILD=true
# Cross-section per hour: 0 = every CONTEXT_UNIVERSE symbol with data that hour; N > 0 = the N of them with the largest
# trailing 24h quote volume (lab, discover and `heartless context`; the live tracker does not read it yet).
# CONTEXT_TOP_N=0

# --- Optional: speed (docs/PERFORMANCE.md) ---
# Live feature frames updated bar by bar (bit-identical to the batch computation, re-checked every few hours).
# INCREMENTAL_FEATURES=true
# Local order book per traded symbol (ctx.book) from the depth streams; off until an alpha uses it. partial: depth20
# snapshots; diff: diff-depth kept in sequence on REST snapshots. Stream speed 100 / 250 / 500 ms; depth band in bps.
# ORDERBOOK_STREAM=false
# ORDERBOOK_MODE=partial
# ORDERBOOK_SPEED_MS=100
# ORDERBOOK_DEPTH_BPS=10.0
# Warn when the local clock and the exchange clock differ by more than this many milliseconds.
# CLOCK_DRIFT_WARN_MS=1000.0
