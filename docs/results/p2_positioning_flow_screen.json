  "fade": "|move| >= m_min: fade the move",
  "div": "d = 4h relative change of the top-trader position ratio - that of the global account ratio; long d >= d_min, short d <= -d_min",
  "quad": "|move| >= m_min and |OI change| >= oi_min: follow if OI grew, fade if it fell",
  "fund_max": "skip if the upcoming funding rate x side > fund_max",
