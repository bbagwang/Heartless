{
 "family": "vol_breakout",
 "tool": "screen",
 "window": [
  "2022-01-13 00:00",
  "2024-12-31 23:59"
 ],
 "universe": "extended (20 symbols)",
 "simulator": "hourly event simulator of the engine's exits (scratch screen.py): decision at the close of the signal bar (1d: 23:59, 4h: every 4h close) on closed bars only, market fill at the next hour's open (+0.25bp half spread +1.5bp slippage, taker 5bp; stress 3bp / 7.5bp), stop sl_atr x ATR14 of the stop timeframe, no target, time stop at hold_h hours minus a minute (close below 0.5R, else breakeven + 1.5 ATR trail on the stop timeframe up to 3x), funding-avoidance exit (r < 0.3, adverse rate > 0.0003), funding paid every 8h, one position per symbol, force-close at the window end; lab warm-up first candle + lookback_days + 2 days; reads nothing at or after 2025-01-01",
 "fidelity": "bars and indicators equal the engine's 4h/1d FeatureFrame columns (max rel. diff 1e-6 for ATR, exact for BB width rank and Donchian); BTC 168h return equal to the stored market context (max diff 0); the alpha's decisions on a real MarketView equal the screen's candidates (ETH and SOL 2023-24: 43/43 and 48/48); vs the engine lab for the default (hybrid, q 0.25): 594 of 595 trades matched with a median |dR| of 0.003, avgR +0.160 vs +0.157; the screen's t_day ran 0.26 above the lab (3.23 vs 2.97) only because 25 trades fall on another UTC exit day (the lab's daily-trail exits fill at 00:00 of the next day, the screen books them at 23:59)",
 "keys": {
  "tf": "decision timeframe (1d: daily close; 4h: every 4h close)",
  "mtf": "stop / trail / box timeframe when it differs from tf",
  "trigger": "4h_dbox: the first 4h close beyond the daily dc-day box of the closed days before its UTC day (the alpha vol_breakout_dbox); absent: the first tf close beyond the prior dc-bar Donchian extreme of tf bars",
  "dc": "box length in bars of the box timeframe",
  "rank": "w60: percentile of the daily BB(20,2) width among its last 60 values; f120: the frame column bb_width_rank (120 bars)",
  "q": "compression: min rank over the k bars before the breakout bar (day) <= q; q >= 1 turns the filter off (control)",
  "trend": "none / btc (BTC 168h return agrees) / own (daily SMA20 vs SMA50 agrees) / both",
  "sl_atr": "stop distance in ATR14 of the stop timeframe",
  "hold_h": "time stop in hours",
  "fund_max": "skip an entry while the upcoming funding rate is adverse by more than this",
  "lookback_days": "warm-up before the first decision (the alpha's lookback_days)"
 },
