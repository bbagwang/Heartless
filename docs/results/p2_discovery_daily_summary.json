 "scripts": {
  "discover_ro.py": "\"\"\"Run `heartless discover` unchanged, except that the `discovery.last` key is not written into the candle DB.\n\nThe long-history candle DB is read-only for researchers; the CLI's last-result key is the only write discover makes\nto it (the trial ledger line and the --out JSON are written as usual).\"\"\"\nimport sys\n\n\ndef _run() -> None:\n    from heartless.core import store as S\n\n    orig = S.Store.set\n\n    def _set(self, key, value):\n        if key == \"discovery.last\":\n            return None\n        return orig(self, key, value)\n\n    S.Store.set = _set\n    from heartless.cli import main\n\n    main(sys.argv[1:])\n\n\nif __name__ == \"__main__\":\n    _run()\n",
  "mkparams.py": "\"\"\"Build a StrategyParams JSON that runs the given discovered rule(s) in the `discovered` alpha.\n\nusage: mkparams.py <discover_out.json> <out_params.json> <rule_id> [<rule_id> ...]\"\"\"\nimport json\nimport sys\n\n\ndef main() -> None:\n    from heartless.strategy.params import StrategyParams\n\n    res = json.load(open(sys.argv[1]))\n    ids = sys.argv[3:]\n    by_id = {r[\"rule\"][\"id\"]: r[\"rule\"] for r in res[\"results\"]}\n    rules = [by_id[i] for i in ids]\n    p = StrategyParams.default()\n    p.version = \"p2-discovery_daily-\" + \"-\".join(ids)\n    p.note = \"discovery_daily rules \" + \", \".join(ids)\n    p.alphas[\"discovered\"][\"rules\"] = rules\n    p.enabled = {a: False for a in p.enabled}\n    p.enabled[\"discovered\"] = True\n    with open(sys.argv[2], \"w\") as f:\n        json.dump(p.to_dict(), f, indent=1)\n    print(json.dumps(rules, indent=1))\n\n\nif __name__ == \"__main__\":\n    main()\n"
 }
