 },
 "script": "\"\"\"Day-of-week seasonality screen for the discovery_daily family (the miner has hour-of-day but no weekday feature).\n\nSame datasets, exit templates, statistics and validation as `heartless discover` (discovery.build_dataset /\nrule_stats / validate), same split inside TRAIN (mine 2022-01-13..2023-12-31, validate 2024). Rules: \"enter on\nweekday d\" (entry minute's UTC weekday, Monday = 0) x side x template, plus \"enter on a weekend day\", on each grid.\nEvery evaluated rule is counted: one ledger line per grid with count = rules evaluated.\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport sys\n\nimport numpy as np\n\n\ndef main() -> None:\n    from heartless.learning import discovery as D\n    from heartless.learning import trials\n    from heartless.learning.lab import parse_when, universe_symbols\n\n    db = \"/home/user/Heartless/data/longhist/heartless.db\"\n    out_path = sys.argv[1]\n    syms = universe_symbols(\"extended\")\n    train = (parse_when(\"2022-01-13\"), parse_when(\"2024-01-01\", end=True))\n    valid = (parse_when(\"2024-01-01\"), parse_when(\"2025-01-01\", end=True))\n    report = {\"train\": [str(x) for x in train], \"valid\": [str(x) for x in valid], \"grids\": {}}\n    for grid in (\"1d\", \"1h\"):\n        sets = {}\n        for name, (a, b) in ((\"train\", train), (\"valid\", valid)):\n            ds = D.build_dataset(db, syms, a, b, grid, workers=int(sys.argv[2]) if len(sys.argv) > 2 else 2, templates=\"all\")\n            dow = (((ds.times + 1) // D.DAY_MS + 3) % 7).astype(float)  # weekday of the entry minute, Monday = 0\n            wkd = (dow >= 5).astype(float)\n            ds.X = np.asfortranarray(np.column_stack([ds.X, dow, wkd]))\n            ds.names = list(ds.names) + [\"t.dow\", \"t.weekend\"]\n            sets[name] = ds\n        tr, va = sets[\"train\"], sets[\"valid\"]\n        fi_dow, fi_wkd = len(tr.names) - 2, len(tr.names) - 1\n        rules = []\n        for side in (1, -1):\n            for ti in tr.templates:\n                for d in range(7):\n                    rules.append(D.Rule(side, ti, ((fi_dow, \">\", d - 0.5), (fi_dow, \"<\", d + 0.5)), grid))\n                rules.append(D.Rule(side, ti, ((fi_wkd, \">\", 0.5),), grid))\n        cfg = {\"screen\": \"dow_seasonality\", \"grid\": grid, \"templates\": \"all\", \"universe\": \"extended\",\n               \"rules\": \"weekday d (0..6) or weekend x side x template, entry-minute UTC weekday\",\n               \"stats\": \"discovery.rule_stats (non-overlapping per symbol, excess vs same-month same-side mean)\",\n               \"train\": \"2022-01-13:2024-01-01\", \"valid\": \"2024-01-01:2025-01-01\"}\n        scored = []\n        for r in rules:\n            st = D.rule_stats(tr, r, 1)\n            scored.append((r, st))\n        n_family = trials.family_tests(\"discovery_daily\") + len(rules)\n        val = D.validate(sorted(scored, key=lambda x: -x[1].get(\"t_ex\", -99))[:20], va, n_family)\n        best = max(scored, key=lambda x: x[1].get(\"t_ex\", -99))[1]\n        line = trials.record(\"screen\", \"discovery_daily\", cfg, train, n=best.get(\"n\"), avg_r=best.get(\"avg_r\"),\n                             t_day=best.get(\"t_ex\"), count=len(rules))\n        rows = []\n        for r, st in scored:\n            rows.append({\"side\": \"LONG\" if r.side > 0 else \"SHORT\", \"tmpl\": D.TEMPLATES[r.tmpl],\n                         \"rule\": \"weekend\" if len(r.conds) == 1 else f\"dow={int(r.conds[0][2] + 0.5)}\",\n                         \"n\": st[\"n\"], \"avg_r\": round(st[\"avg_r\"], 4), \"avg_ex\": round(st.get(\"avg_ex\", 0), 4),\n                         \"t\": round(st[\"t\"], 2), \"t_ex\": round(st.get(\"t_ex\", -99), 2)})\n        rows.sort(key=lambda x: -x[\"t_ex\"])\n        report[\"grids\"][grid] = {\"rules\": len(rules), \"rows_train\": int(len(tr.times)), \"rows_valid\": int(len(va.times)),\n                                 \"n_family_bar\": n_family, \"t_bar\": D.multiple_testing_t(n_family),\n                                 \"ledger_hash\": line[\"config_hash\"], \"top\": rows[:20],\n                                 \"validated\": [v for v in val if v[\"passed\"]],\n                                 \"valid_of_top\": [{\"rule\": v[\"rule\"][\"conds\"], \"side\": v[\"rule\"][\"side\"],\n                                                   \"hold\": v[\"rule\"][\"hold_min\"], \"tp\": v[\"rule\"][\"tp_r\"],\n                                                   \"valid\": v[\"rule\"][\"stats\"][\"valid\"]} for v in val[:10]]}\n        print(grid, json.dumps(rows[:10]), flush=True)\n        del sets, tr, va\n    with open(out_path, \"w\") as f:\n        json.dump(report, f, indent=1, default=str)\n\n\nif __name__ == \"__main__\":\n    main()\n"
}